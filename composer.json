{
  "name": "ssx/module-remove-elastic-suite-notification",
  "version": "1.2.0",
  "description": "Removes the Smile Elasticsuite upsell, telemetry and RSS feed notifications from the Magento admin.",
  "type": "magento2-module",
  "require": {
    "magento/framework": "*",
    "smile/elasticsuite": "^2.12"
  },
  "license": [
    "MIT"
  ],
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Ssx\\RemoveElasticSuiteNotification\\": ""
    }
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
